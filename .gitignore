__pycache__/
*.pyc
.DS_Store

# Local Claude Code permission grants — machine-specific, and contains an
# allowlist you may not want mirrored to GitHub.
.claude/settings.local.json

# Scratch note used to pass requests mid-session — not part of the work.
Untitled.md

# TLC scratch output — regenerated on every model-check run.
site/states/
*.old
.toolbox/

# Obsidian: keep the shared vault config (app/appearance/core-plugins),
# ignore the per-machine UI state, which rewrites itself constantly.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# bare fragments for the Artifact publisher; the served pages are the real documents
docs/_bare_*.html
